      "uid": "prometheus"
     },
     "expr": "otsim_site{kpi=\"carbon_kg_per_h\"}",
     "legendFormat": "carbon kg/h",
     "refId": "C"
    }
   ]
  },
  {
   "type": "row",
   "title": "DCIM collector (read over Modbus / SNMP / Redfish)",
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 40
   },
   "panels": []
  },
  {
   "type": "timeseries",
   "title": "CDU over Modbus vs Redfish",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 41
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
