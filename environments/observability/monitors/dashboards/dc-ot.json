{
 "title": "Data centre OT (otsim)",
 "uid": "testenv-dc-ot",
 "schemaVersion": 39,
 "version": 1,
 "editable": true,
 "time": {
  "from": "now-1h",
  "to": "now"
 },
 "refresh": "10s",
 "tags": [
  "testenv",
  "ot"
 ],
 "annotations": {
  "list": [
   {
    "name": "OT faults",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "enable": true,
    "iconColor": "orange",
    "expr": "otsim_fault_active",
    "titleFormat": "{{type}}",
    "textFormat": "{{device}}",
    "step": "15s"
   },
   {
    "name": "Simulation faults",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "enable": true,
    "iconColor": "red",
    "expr": "max by (simulation, type) (sim_simulation_active) > 0",
    "titleFormat": "{{simulation}}",
    "textFormat": "{{type}}",
    "step": "15s"
   }
  ]
 },
 "panels": [
  {
   "type": "row",
   "title": "Site",
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 0
   },
   "panels": []
  },
  {
   "type": "stat",
   "title": "PUE",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 5,
    "w": 4,
    "x": 0,
    "y": 1
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "otsim_site{kpi=\"pue\"}",
     "legendFormat": "{{site}} ({{region}})",
     "refId": "A"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "IT / facility power",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 5,
    "w": 10,
    "x": 4,
    "y": 1
   },
   "fieldConfig": {
    "defaults": {
     "unit": "kwatt"
    },
    "overrides": []
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "otsim_site{kpi=\"it_kw\"}",
     "legendFormat": "IT kW",
     "refId": "A"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "otsim_site{kpi=\"facility_kw\"}",
     "legendFormat": "facility kW",
     "refId": "B"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "otsim_site{kpi=\"cooling_kw\"}",
     "legendFormat": "cooling kW",
     "refId": "C"
    }
   ]
  },
  {
   "type": "stat",
   "title": "Active alarms",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 5,
    "w": 5,
    "x": 14,
    "y": 1
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (severity) (otsim_alarm)",
     "legendFormat": "{{severity}}",
     "refId": "A"
    }
   ]
  },
  {
   "type": "stat",
   "title": "Injected faults",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 5,
    "w": 5,
    "x": 19,
    "y": 1
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "count(otsim_fault_active) or vector(0)",
     "legendFormat": "faults",
     "refId": "A"
    }
   ]
  },
  {
   "type": "row",
   "title": "Power path",
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 6
   },
   "panels": []
  },
  {
   "type": "timeseries",
   "title": "UPS battery and source",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percent"
    },
    "overrides": []
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "otsim_point{type=\"ups\",point=\"battery_charge_pct\"}",
     "legendFormat": "{{device}} charge %",
     "refId": "A"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "otsim_point{type=\"ups\",point=\"on_battery\"}*100",
     "legendFormat": "{{device}} on battery",
     "refId": "B"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "otsim_point{type=\"ats\",point=\"source\"}*50",
     "legendFormat": "ATS source (50 utility, 100 generator)",
     "refId": "C"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Utility voltage / frequency",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "otsim_point{type=\"utility\",point=\"voltage_v\"}",
     "legendFormat": "voltage V",
     "refId": "A"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "otsim_point{type=\"utility\",point=\"frequency_hz\"}",
     "legendFormat": "frequency Hz",
     "refId": "B"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Rack PDU power",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 15
   },
   "fieldConfig": {
    "defaults": {
     "unit": "kwatt"
    },
    "overrides": []
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "otsim_point{type=\"rack-pdu\",point=\"power_kw\"}",
     "legendFormat": "{{device}}",
     "refId": "A"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Generator",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 15
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "otsim_point{type=\"generator\",point=\"running\"}",
     "legendFormat": "{{device}} running",
     "refId": "A"
    }
   ]
  },
  {
   "type": "row",
   "title": "Cooling",
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 23
   },
   "panels": []
  },
  {
   "type": "timeseries",
   "title": "CDU supply / return",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 24
   },
   "fieldConfig": {
    "defaults": {
     "unit": "celsius"
    },
    "overrides": []
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "otsim_point{type=\"cdu\",point=\"supply_temp_c\"}",
     "legendFormat": "{{device}} supply",
     "refId": "A"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "otsim_point{type=\"cdu\",point=\"return_temp_c\"}",
     "legendFormat": "{{device}} return",
     "refId": "B"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "CDU flow and reservoir",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 24
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "otsim_point{type=\"cdu\",point=\"flow_lpm\"}",
     "legendFormat": "{{device}} flow L/min",
