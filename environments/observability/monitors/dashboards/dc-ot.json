     "refId": "B"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Protocol requests/s",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 41
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (protocol) (rate(otsim_protocol_requests_total[1m]))",
     "legendFormat": "{{protocol}}",
     "refId": "A"
