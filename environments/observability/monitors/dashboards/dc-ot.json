   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "otsim_site{kpi=\"rack_inlet_c\"}",
     "legendFormat": "rack inlet",
     "refId": "A"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "otsim_site{kpi=\"chilled_water_supply_c\"}",
     "legendFormat": "chilled water supply",
     "refId": "B"
    },
    {
     "datasource": {
      "type": "prometheus",
