     },
     "expr": "otsim_point{type=\"cdu\",point=\"reservoir_level_pct\"}",
     "legendFormat": "{{device}} reservoir %",
     "refId": "B"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Rack inlet / chilled water / ambient",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 32
   },
   "fieldConfig": {
    "defaults": {
     "unit": "celsius"
    },
