{
 "title": "Test environments: simulations",
 "uid": "testenv-simulations",
 "schemaVersion": 39,
 "version": 1,
 "editable": true,
 "time": {
  "from": "now-1h",
  "to": "now"
 },
 "refresh": "10s",
 "tags": [
  "testenv",
  "simulations"
 ],
 "annotations": {
  "list": [
   {
    "name": "Simulation faults",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "enable": true,
    "iconColor": "red",
    "expr": "max by (simulation, type) (sim_simulation_active) > 0",
    "titleFormat": "{{simulation}}",
    "textFormat": "{{type}}",
    "step": "15s"
   }
  ]
 },
 "panels": [
  {
   "type": "row",
   "title": "Simulations",
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 0
   },
   "panels": []
  },
  {
   "type": "stat",
   "title": "Active simulations",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 6,
    "w": 4,
    "x": 0,
    "y": 1
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(sim_simulation_active) or vector(0)",
     "legendFormat": "active",
     "refId": "A"
    }
   ]
  },
  {
   "type": "state-timeline",
   "title": "Simulation timeline (1 = fault injected)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 6,
    "w": 20,
    "x": 4,
    "y": 1
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max by (simulation, type) (sim_simulation_active)",
     "legendFormat": "{{simulation}} ({{type}})",
     "refId": "A"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Probe success rate",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (simulation, probe) (rate(sim_probe_total{result=\"success\"}[1m])) / sum by (simulation, probe) (rate(sim_probe_total[1m]))",
     "legendFormat": "{{simulation}}/{{probe}}",
     "refId": "A"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Probe latency p95",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.95, sum by (le, simulation, probe) (rate(sim_probe_duration_seconds_bucket[1m])))",
     "legendFormat": "{{simulation}}/{{probe}}",
     "refId": "A"
    }
   ]
  },
  {
   "type": "row",
   "title": "Inference: Dynamo",
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 15
   },
   "panels": []
  },
  {
   "type": "timeseries",
   "title": "Dynamo requests/s by status",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 16
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (namespace, status) (rate(dynamo_frontend_requests_total[1m]))",
     "legendFormat": "{{namespace}} {{status}}",
     "refId": "A"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Dynamo latency p95 / TTFT p95 / ITL p95",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 16
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.95, sum by (le) (rate(dynamo_frontend_request_duration_seconds_bucket[1m])))",
     "legendFormat": "request p95",
     "refId": "A"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.95, sum by (le) (rate(dynamo_frontend_time_to_first_token_seconds_bucket[1m])))",
     "legendFormat": "TTFT p95",
     "refId": "B"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.95, sum by (le) (rate(dynamo_frontend_inter_token_latency_seconds_bucket[1m])))",
     "legendFormat": "ITL p95",
     "refId": "C"
    }
   ]
  },
  {
   "type": "row",
   "title": "Inference: Triton",
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 24
   },
   "panels": []
  },
  {
   "type": "timeseries",
   "title": "Triton success / failure per s",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 25
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (model) (rate(nv_inference_request_success[1m]))",
     "legendFormat": "{{model}} ok",
     "refId": "A"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (model) (rate(nv_inference_request_failure[1m]))",
     "legendFormat": "{{model}} fail",
     "refId": "B"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Triton request / queue time",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 25
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ms"
    },
    "overrides": []
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (model) (rate(nv_inference_request_duration_us[1m])) / clamp_min(sum by (model) (rate(nv_inference_request_success[1m])), 1e-9) / 1000",
     "legendFormat": "{{model}} request ms",
     "refId": "A"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (model) (rate(nv_inference_queue_duration_us[1m])) / clamp_min(sum by (model) (rate(nv_inference_request_success[1m])), 1e-9) / 1000",
     "legendFormat": "{{model}} queue ms",
     "refId": "B"
    }
   ]
  },
  {
   "type": "row",
   "title": "GPUs (Mokka / fake-gpu-operator)",
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 33
   },
   "panels": []
  },
  {
   "type": "timeseries",
   "title": "GPU utilization",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 34
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percent"
    },
    "overrides": []
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "avg by (namespace, Hostname) (DCGM_FI_DEV_GPU_UTIL)",
     "legendFormat": "{{namespace}} {{Hostname}}",
     "refId": "A"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "GPU temperature / XID",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 34
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max by (Hostname, gpu) (DCGM_FI_DEV_GPU_TEMP)",
     "legendFormat": "{{Hostname}} gpu{{gpu}} \u00b0C",
     "refId": "A"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max by (Hostname, gpu) (DCGM_FI_DEV_XID_ERRORS)",
     "legendFormat": "{{Hostname}} gpu{{gpu}} xid",
     "refId": "B"
    }
   ]
  },
  {
   "type": "row",
   "title": "Kubernetes",
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 42
   },
   "panels": []
  },
  {
   "type": "timeseries",
   "title": "Container restarts (increase 5m)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 43
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (namespace) (increase(kube_pod_container_status_restarts_total[5m]))",
     "legendFormat": "{{namespace}}",
     "refId": "A"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Ready pods",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 43
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (namespace) (kube_pod_status_ready{condition=\"true\"})",
     "legendFormat": "{{namespace}}",
     "refId": "A"
    }
   ]
  },
  {
   "type": "row",
   "title": "Network (KNE routers via gNMI)",
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 51
   },
   "panels": []
  },
  {
   "type": "timeseries",
   "title": "Router interface packets/s",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 52
   },
   "fieldConfig": {
    "defaults": {
     "unit": "pps"
    },
    "overrides": []
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (source, interface_name) (rate(gnmic_interfaces_interface_state_counters_in_pkts[1m]))",
     "legendFormat": "{{source}} {{interface_name}} in",
     "refId": "A"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (source, interface_name) (rate(gnmic_interfaces_interface_state_counters_out_pkts[1m]))",
     "legendFormat": "{{source}} {{interface_name}} out",
     "refId": "B"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Router interface errors/s",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 52
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (source, interface_name) (rate(gnmic_interfaces_interface_state_counters_in_errors[1m]))",
     "legendFormat": "{{source}} {{interface_name}}",
     "refId": "A"
    }
   ]
  }
 ]
}