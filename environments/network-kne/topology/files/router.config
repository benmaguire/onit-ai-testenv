hostname {{ .name }}
username {{ .Values.routerUsername }}
 group root-lr
 group cisco-support
 secret 0 {{ .Values.routerPassword }}
!
interface Loopback0
 ipv4 address {{ .loopback }} 255.255.255.255
!
interface GigabitEthernet0/0/0/0
 description to-{{ .peer }}
 ipv4 address {{ .p2p }} 255.255.255.252
 no shutdown
!
interface GigabitEthernet0/0/0/1
 description to-{{ .host }}
 ipv4 address {{ .lan }} 255.255.255.0
 no shutdown
!
router ospf 1
 router-id {{ .loopback }}
 area 0
  interface Loopback0
   passive enable
  !
  interface GigabitEthernet0/0/0/0
   network point-to-point
  !
  interface GigabitEthernet0/0/0/1
   passive enable
  !
 !
!
router bgp 65000
 bgp router-id {{ .loopback }}
 address-family ipv4 unicast
  network {{ .lanNet }}/24
 !
 neighbor {{ .peerLoopback }}
  remote-as 65000
  update-source Loopback0
  address-family ipv4 unicast
  !
 !
!
grpc
 port 57400
 no-tls
 address-family ipv4
!
ssh server v2
ssh server vrf default
end
